{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traceintel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/docs", "/redoc", "/openapi.json"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "API_ORIGIN": "https://traceintel-api.onrender.com",
  },
  "secrets": {
    "required": ["API_PROXY_TOKEN"],
  },
}

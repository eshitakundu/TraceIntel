TRACEINTEL_ENVIRONMENT=development
TRACEINTEL_CORS_ORIGINS=["http://localhost:5173"]
TRACEINTEL_DATABASE_URL=sqlite+aiosqlite:///./traceintel.db
# Production: postgresql+asyncpg://user:password@host:5432/traceintel
TRACEINTEL_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
TRACEINTEL_MONAD_RPC_URL=https://rpc.monad.xyz
# Keep secrets here, never in VITE_* variables.
TRACEINTEL_OPENROUTER_API_KEY=
TRACEINTEL_OPENROUTER_MODEL=